# --- NextAuth ---
# URL pubblico dell'app (impostare il dominio Vercel in Produzione)
NEXTAUTH_URL=https://recuperiamo.vercel.app
# Segreto usato da NextAuth per cifrare i token
NEXTAUTH_SECRET=replace-with-strong-random-secret

# --- Database (Neon consigliato) ---
# Usa la STRINGA DI CONNESSIONE CON POOLING (pooler) e SSL attivo
# Esempio Neon: postgresql://user:password@ep-xxxx--pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Realtime (Ably) ---
# Chiave API di Ably per la comunicazione realtime (lavagna, notifiche, ecc.)
# Ottienila da https://ably.com/dashboard
NEXT_PUBLIC_ABLY_API_KEY=your-ably-api-key-here

# --- Base URL assoluto per fetch server-side (opzionale) ---
# Se non impostato, il codice fa fallback a NEXTAUTH_URL o localhost in sviluppo
NEXT_PUBLIC_BASE_URL=https://recuperiamo.vercel.app

# --- Note ---
# - In sviluppo locale crea un file .env.local con le stesse variabili
# - In Produzione su Vercel configura tutte le variabili nelle impostazioni del progetto
# - NEXT_PUBLIC_ABLY_API_KEY deve essere configurata su Vercel per tutti gli ambienti (Production, Preview, Development)
# - Per migrazioni Prisma in CI opzionale: SHADOW_DATABASE_URL
