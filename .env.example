# --- NextAuth ---
# URL pubblico dell'app (impostare il dominio Vercel in Produzione)
NEXTAUTH_URL=https://recuperiamo.vercel.app
# Segreto usato da NextAuth per cifrare i token
NEXTAUTH_SECRET=replace-with-strong-random-secret

# --- Database (Neon consigliato) ---
# Usa la STRINGA DI CONNESSIONE CON POOLING (pooler) e SSL attivo
# Esempio Neon: postgresql://user:password@ep-xxxx--pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Realtime (Socket.IO) ---
# URL pubblico del microservizio realtime esterno (Strategy A)
# Esempio: https://realtime.recuperiamo.app
NEXT_PUBLIC_SOCKET_URL=https://your-realtime-service.example

# --- Base URL assoluto per fetch server-side (opzionale) ---
# Se non impostato, il codice fa fallback a NEXTAUTH_URL o localhost in sviluppo
NEXT_PUBLIC_BASE_URL=https://recuperiamo.vercel.app

# --- Ably Realtime (alternativa serverless a Socket.IO) ---
# Impostala su Vercel per attivare Ably in produzione; in assenza, rimane il fallback Socket.IO
# Per autenticazione token-based: chiave server Ably (da tenere solo su Vercel, non pubblica)
ABLY_API_KEY=xxxx:yyyy

# --- Note ---
# - In sviluppo locale non serve NEXT_PUBLIC_SOCKET_URL (usa /api/socketio)
# - In Produzione su Vercel DEVI impostare NEXT_PUBLIC_SOCKET_URL al microservizio realtime
# - Assicurati che il microservizio abbia CORS_ORIGIN=https://recuperiamo.vercel.app
# - Per migrazioni Prisma in CI opzionale: SHADOW_DATABASE_URL
