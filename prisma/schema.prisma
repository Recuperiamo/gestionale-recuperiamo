generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// *
///  * ====================== AUTENTICAZIONE ======================
model User {
  id                     Int                      @id @default(autoincrement())
  email                  String                   @unique
  name                   String?
  password               String
  roleId                 Int
  accounts               Account[]
  LavagnaShape           LavagnaShape[]
  LavagnaTratto          LavagnaTratto[]
  pacchettoAlertLetti    PacchettoAlertLetto[]
  sessions               Session[]
  role                   Role                     @relation(fields: [roleId], references: [id])
  passwordResetRequests  PasswordResetRequest[]   @relation("UserPasswordResetRequests")
  passwordResetReviews   PasswordResetRequest[]   @relation("UserPasswordResetReviews")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Client {
  id                Int                 @id @default(autoincrement())
  nomeReferente     String
  email             String
  telefono          String?
  indirizzo         String?
  codiceFiscale     String?             @unique
  partitaIva        String?             @unique
  note              String?
  tipo              ClientType          @default(REFERENTE)
  referenteId       Int?
  materie           String[]            @default([])
  coloreTema        String?
  linkVideolezione  String?
  attivita          Attivita[]
  referente         Client?             @relation("ReferenteStudenti", fields: [referenteId], references: [id])
  studenti          Client[]            @relation("ReferenteStudenti")
  OreExtra          OreExtra[]
  pacchetti         PacchettoOre[]
  richiesteModifica RichiestaModifica[]

  @@index([email])
  @@index([referenteId])
}

model PacchettoOre {
  id                  Int                   @id @default(autoincrement())
  clienteId           Int
  descrizione         String
  oreAcquistate       Int
  oreResidue          Int
  dataAttivazione     DateTime
  dataScadenza        DateTime?
  stato               String
  note                String?
  sogliaOreResidue    Int?
  attivita            Attivita[]
  OreExtra            OreExtra[]
  pacchettoAlertLetti PacchettoAlertLetto[]
  cliente             Client                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  changelog           Pacchetto_ChangeLog[]

  @@index([clienteId])
}

model PacchettoAlertLetto {
  id          Int          @id @default(autoincrement())
  userId      Int
  pacchettoId Int
  letto       Boolean      @default(true)
  dataLetto   DateTime     @default(now())
  pacchetto   PacchettoOre @relation(fields: [pacchettoId], references: [id])
  user        User         @relation(fields: [userId], references: [id])

  @@unique([userId, pacchettoId])
}

model Pacchetto_ChangeLog {
  id                   Int           @id @default(autoincrement())
  pacchettoId          Int?
  orePrima             Float
  oreDopo              Float
  tipoOperazione       String
  attivitaId           Int?
  utente               String
  timestamp            DateTime      @default(now())
  motivazione          String?
  pacchettoDescrizione String?
  attivita             Attivita?     @relation(fields: [attivitaId], references: [id])
  pacchetto            PacchettoOre? @relation(fields: [pacchettoId], references: [id])
}

/// *
///  * ====================== ATTIVITA ======================
model Attivita {
  id                Int                   @id @default(autoincrement())
  createdAt         DateTime              @default(now())
  descrizione       String?
  oreConsumate      Int
  pacchettoId       Int?
  clienteId         Int
  durataOre         Float?
  orario            DateTime?
  ricorrenzaId      Int?
  stato             String?
  orarioOriginale   DateTime?
  cliente           Client                @relation(fields: [clienteId], references: [id])
  pacchetto         PacchettoOre?         @relation(fields: [pacchettoId], references: [id])
  Lavagna           Lavagna?
  changelog         Pacchetto_ChangeLog[]
  richiesteModifica RichiestaModifica[]

  @@index([clienteId])
  @@index([pacchettoId])
  @@index([orario])
}

model RichiestaModifica {
  id             Int            @id @default(autoincrement())
  attivitaId     Int
  clienteId      Int
  tipo           RichiestaTipo
  stato          RichiestaStato @default(pending)
  nuovaData      DateTime?
  nuovoOrario    DateTime?
  nuovaDurataOre Float?
  noteStudente   String?
  noteAdmin      String?
  processedAt    DateTime?
  processedBy    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  attivita       Attivita       @relation(fields: [attivitaId], references: [id])
  cliente        Client         @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([attivitaId])
}

/// *
///  * ====================== RICHIESTE LAVAGNA ======================
model RichiestaLavagna {
  id           Int            @id @default(autoincrement())
  clienteId    Int
  titolo       String?
  noteStudente String?
  noteAdmin    String?
  stato        RichiestaStato @default(pending)
  processedAt  DateTime?
  processedBy  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lavagnaId    Int?

  @@index([clienteId])
  @@index([stato])
}

/// *
///  * ====================== MATERIALE DIDATTICO ======================
model MaterialeDidattico {
  id            Int              @id @default(autoincrement())
  clienteId     Int
  titolo        String
  materia       String?
  nomeOriginale String
  blobUrl       String
  mimeType      String?
  fileSize      Int?
  uploadedBy    String?
  uploadBatchId String?          // ID batch per raggruppare file caricati insieme
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sezione       MaterialeSezione @default(MATERIALE)

  @@index([clienteId])
  @@index([createdAt])
  @@index([uploadBatchId])
}

model Lavagna {
  id         Int             @id @default(autoincrement())
  attivitaId Int             @unique
  titolo     String?         @default("Lavagna")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  attivita   Attivita        @relation(fields: [attivitaId], references: [id])
  shapes     LavagnaShape[]
  tratti     LavagnaTratto[]

  @@index([createdAt])
}

model LavagnaTratto {
  id           Int       @id @default(autoincrement())
  lavagnaId    Int
  autoreUserId Int
  strumento    String
  colore       String?
  spessore     Float?
  punti        Json
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  streamId     String?   @unique
  autoreUser   User      @relation(fields: [autoreUserId], references: [id])
  lavagna      Lavagna   @relation(fields: [lavagnaId], references: [id])

  @@index([lavagnaId])
  @@index([autoreUserId])
  @@index([createdAt])
}

/// *
///  * ====================== LAVAGNA SHAPES ======================
///  * Forme vettoriali persistite sulla lavagna (rettangoli, cerchi, assi, ecc.)
model LavagnaShape {
  id            Int       @id @default(autoincrement())
  lavagnaId     Int
  kind          String
  x             Float?
  y             Float?
  w             Float?
  h             Float?
  x1            Float?
  y1            Float?
  x2            Float?
  y2            Float?
  colore        String?
  spessore      Float?
  autoreUserId  Int?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  materialeId   Int?
  nomeOriginale String?
  rotation      Float?
  src           String?
  srcPreview    String?
  titolo        String?
  url           String?
  autoreUser    User?     @relation(fields: [autoreUserId], references: [id])
  lavagna       Lavagna   @relation(fields: [lavagnaId], references: [id])

  @@index([lavagnaId])
  @@index([createdAt])
}

model OreExtra {
  id               Int           @id @default(autoincrement())
  clienteId        Int
  pacchettoId      Int?
  ore              Float
  descrizione      String?
  dataTracciamento DateTime      @default(now())
  dataAssegnamento DateTime?
  stato            String        @default("pending")
  note             String?
  tracciaDa        String?
  assegnatoDa      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime
  Client           Client        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  PacchettoOre     PacchettoOre? @relation(fields: [pacchettoId], references: [id])

  @@index([clienteId])
  @@index([pacchettoId])
  @@index([stato])
}

/// *
///  * ====================== CLIENTI / PACCHETTI ======================
enum ClientType {
  REFERENTE
  STUDENTE
}

/// *
///  * ====================== RICHIESTE MODIFICA ======================
enum RichiestaStato {
  pending
  in_review
  approved
  rejected
  archived
}

enum RichiestaTipo {
  cambio_data
  cambio_orario
  cancellazione
}

enum MaterialeSezione {
  MATERIALE
  COMPITI
  VOTI
}

enum PasswordResetStatus {
  PENDING
  REJECTED
  COMPLETED
}

model PasswordResetRequest {
  id              Int                  @id @default(autoincrement())
  userId          Int
  user            User                 @relation("UserPasswordResetRequests", fields: [userId], references: [id], onDelete: Cascade)
  status          PasswordResetStatus  @default(PENDING)
  reviewedBy      Int?
  reviewer        User?                @relation("UserPasswordResetReviews", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  completedAt     DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([userId])
  @@index([status])
  @@map("password_reset_requests")
}
