// =====================================================
// Prisma Schema - Gestionale Recuperiamo
// Versione: rimozione unique (attivitaId, stato) per consentire archiviazioni multiple
// =====================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * ====================== AUTENTICAZIONE ======================
 */
model User {
  id                  Int                   @id @default(autoincrement())
  email               String                @unique
  name                String?
  password            String
  roleId              Int
  accounts            Account[]
  sessions            Session[]
  role                Role                  @relation(fields: [roleId], references: [id])
  pacchettoAlertLetti PacchettoAlertLetto[]
  LavagnaTratto       LavagnaTratto[]
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * ====================== CLIENTI / PACCHETTI ======================
 */
enum ClientType {
  REFERENTE
  STUDENTE
}

model Client {
  id                Int                 @id @default(autoincrement())
  nomeReferente     String
  email             String
  telefono          String?
  indirizzo         String?
  codiceFiscale     String?             @unique
  partitaIva        String?             @unique
  note              String?
  materie           String[]            @default([])
  tipo              ClientType          @default(REFERENTE)
  referenteId       Int?
  referente         Client?             @relation("ReferenteStudenti", fields: [referenteId], references: [id], onDelete: SetNull)
  studenti          Client[]            @relation("ReferenteStudenti")
  pacchetti         PacchettoOre[]
  attivita          Attivita[]
  richiesteModifica RichiestaModifica[]

  @@index([email])
  @@index([referenteId])
}

model PacchettoOre {
  id                  Int                   @id @default(autoincrement())
  clienteId           Int
  descrizione         String
  oreAcquistate       Int
  oreResidue          Int
  dataAttivazione     DateTime
  dataScadenza        DateTime?
  stato               String
  note                String?
  sogliaOreResidue    Int?
  attivita            Attivita[]
  cliente             Client                @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pacchettoAlertLetti PacchettoAlertLetto[]
  changelog           Pacchetto_ChangeLog[]

  @@index([clienteId])
}

model PacchettoAlertLetto {
  id          Int          @id @default(autoincrement())
  userId      Int
  pacchettoId Int
  letto       Boolean      @default(true)
  dataLetto   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  pacchetto   PacchettoOre @relation(fields: [pacchettoId], references: [id])

  @@unique([userId, pacchettoId])
}

model Pacchetto_ChangeLog {
  id                   Int           @id @default(autoincrement())
  pacchettoId          Int?
  pacchetto            PacchettoOre? @relation(fields: [pacchettoId], references: [id], onDelete: SetNull)
  pacchettoDescrizione String?
  orePrima             Float
  oreDopo              Float
  tipoOperazione       String
  attivitaId           Int?
  attivita             Attivita?     @relation(fields: [attivitaId], references: [id], onDelete: SetNull)
  utente               String
  timestamp            DateTime      @default(now())
  motivazione          String?
}

/**
 * ====================== ATTIVITA ======================
 */
model Attivita {
  id           Int                   @id @default(autoincrement())
  createdAt    DateTime              @default(now())
  descrizione  String?
  oreConsumate Int
  pacchettoId  Int?
  pacchetto    PacchettoOre?         @relation(fields: [pacchettoId], references: [id])
  clienteId    Int
  cliente      Client                @relation(fields: [clienteId], references: [id])
  ricorrenzaId Int?
  changelog    Pacchetto_ChangeLog[]

  orario          DateTime?
  orarioOriginale DateTime?
  durataOre       Float?
  stato           String?

  richiesteModifica RichiestaModifica[]
  Lavagna           Lavagna?

  @@index([clienteId])
  @@index([pacchettoId])
  @@index([orario])
}

/**
 * ====================== RICHIESTE MODIFICA ======================
 */
enum RichiestaStato {
  pending
  in_review
  approved
  rejected
  archived
}

enum RichiestaTipo {
  cambio_data
  cambio_orario
  cancellazione
}

model RichiestaModifica {
  id             Int            @id @default(autoincrement())
  attivitaId     Int
  clienteId      Int
  tipo           RichiestaTipo
  stato          RichiestaStato @default(pending)
  nuovaData      DateTime?
  nuovoOrario    DateTime?
  nuovaDurataOre Float?
  noteStudente   String?
  noteAdmin      String?
  processedAt    DateTime?
  processedBy    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  attivita Attivita @relation(fields: [attivitaId], references: [id])
  cliente  Client   @relation(fields: [clienteId], references: [id])

  @@index([clienteId])
  @@index([attivitaId])
}

/**
 * ====================== RICHIESTE LAVAGNA ======================
 */
model RichiestaLavagna {
  id           Int            @id @default(autoincrement())
  clienteId    Int
  titolo       String?
  noteStudente String?
  noteAdmin    String?
  stato        RichiestaStato @default(pending)
  processedAt  DateTime?
  processedBy  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lavagnaId    Int?

  @@index([clienteId])
  @@index([stato])
}

/**
 * ====================== MATERIALE DIDATTICO ======================
 */
model MaterialeDidattico {
  id            Int      @id @default(autoincrement())
  clienteId     Int
  titolo        String
  materia       String?
  nomeOriginale String
  blobUrl       String   // URL del file su Vercel Blob
  mimeType      String?
  fileSize      Int?     // dimensione in bytes
  uploadedBy    String?  // email o nome utente che ha caricato
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clienteId])
  @@index([createdAt])
}

model Lavagna {
  id         Int             @id @default(autoincrement())
  attivitaId Int             @unique
  titolo     String?         @default("Lavagna")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  tratti     LavagnaTratto[]
  attivita   Attivita        @relation(fields: [attivitaId], references: [id])

  // Se vuoi un indice secondario per query future su createdAt:
  @@index([createdAt])
}

model LavagnaTratto {
  id           Int       @id @default(autoincrement())
  streamId     String?   @unique
  lavagnaId    Int
  autoreUserId Int
  strumento    String // "penna" | "gomma" (possibile estensione)
  colore       String? // es. "#20489a"
  spessore     Float? // es. 2.5
  punti        Json // [{x:.., y:..}, ...]
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  lavagna      Lavagna   @relation(fields: [lavagnaId], references: [id])
  autoreUser   User      @relation(fields: [autoreUserId], references: [id])

  @@index([lavagnaId])
  @@index([autoreUserId])
  @@index([createdAt])
}

/**
 * ====================== LAVAGNA SHAPES ======================
 * Forme vettoriali persistite sulla lavagna (rettangoli, cerchi, assi, ecc.)
 */
model LavagnaShape {
  id           Int       @id @default(autoincrement())
  lavagnaId    Int
  kind         String
  // Bounding box o coordinate base
  x            Float?
  y            Float?
  w            Float?
  h            Float?
  // Coordinate addizionali per linee/assi
  x1           Float?
  y1           Float?
  x2           Float?
  y2           Float?
  // Stile
  colore       String?
  spessore     Float?
  // Autore e auditing
  autoreUserId Int?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  lavagna    Lavagna @relation(fields: [lavagnaId], references: [id])
  autoreUser User?   @relation(fields: [autoreUserId], references: [id])

  @@index([lavagnaId])
  @@index([createdAt])
}
